# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=akinel_db
POSTGRES_USER=akinel_user
POSTGRES_PASSWORD=akinel_pass
POSTGRES_PORT=5432

# ── Backend — ASP.NET Core ────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# JWT — REQUIRED in Production/Staging. Minimum 32 characters.
# Generate: openssl rand -base64 48
Jwt__Secret=REPLACE_WITH_STRONG_RANDOM_SECRET_MINIMUM_32_CHARS

Jwt__Issuer=akinel-api
Jwt__Audience=akinel-web

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Backblaze B2 (S3-compatible) — set in production Railway env vars
B2__Endpoint=s3.eu-central-003.backblazeb2.com
B2__KeyId=
B2__ApplicationKey=
B2__BucketName=akinel-uploads
B2__BucketId=
B2__CdnUrl=

# Sentry (error tracking) — set in production; leave empty to disable
Sentry__Dsn=

# Feature flags — override individual flags without code change
# Features__VinSearch=false       # Disables VIN decode (backend 503 + frontend hidden)
# Features__MaintenanceMode=true  # Shows maintenance page

# ── Frontend — Next.js ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5100

# App environment label — used by Sentry to distinguish dev/staging/prod
NEXT_PUBLIC_APP_ENV=development

# Sentry — same DSN as backend, exposed to browser (not a secret)
NEXT_PUBLIC_SENTRY_DSN=

# PostHog (product analytics) — leave empty to disable analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Sentry source maps (CI only) ──────────────────────────────────────────────
# Needed only in deployment pipeline to upload source maps for readable stack traces
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
