{
  "Sentry": {
    "TracesSampleRate": 0.5
  },
  "Features": {
    "VinSearch": true,
    "StockNotifications": true,
    "Analytics": true,
    "MaintenanceMode": false
  },
  "RateLimiting": {
    "Login": { "PermitLimit": 10, "WindowMinutes": 1 },
    "Register": { "PermitLimit": 5, "WindowMinutes": 60 },
    "Checkout": { "PermitLimit": 10, "WindowMinutes": 60 },
    "Search": { "PermitLimit": 60, "WindowMinutes": 1 },
    "VinDecode": { "PermitLimit": 10, "WindowMinutes": 1 }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
